# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret for signing JWT tokens.
JWT_SECRET="MY_JWT_SECRET"

# DATABASE_URL: Neon PostgreSQL connection string
DATABASE_URL="postgres://user:password@ep-cool-butterfly-123456.us-east-2.aws.neon.tech/dbname?sslmode=require"

# SMTP_HOST: SMTP server hostname (e.g., smtp.gmail.com)
SMTP_HOST="smtp.gmail.com"

# SMTP_PORT: SMTP server port (usually 587 or 465)
SMTP_PORT="587"

# SMTP_USER: SMTP username / email address
SMTP_USER="your-email@gmail.com"

# SMTP_PASS: SMTP password or App Password
SMTP_PASS="your-app-password"

# FROM_EMAIL: Sender email address used for OTPs
FROM_EMAIL="noreply@bubuwish.com"

# CLOUDINARY_CLOUD_NAME: Cloudinary cloud name for media upload
VITE_CLOUDINARY_CLOUD_NAME="your_cloud_name"

# CLOUDINARY_UPLOAD_PRESET: Unsigned upload preset for direct frontend media upload
VITE_CLOUDINARY_UPLOAD_PRESET="your_unsigned_preset"

# CLOUDINARY_API_SECRET: Cloudinary secret for backend API calls
CLOUDINARY_API_SECRET="your_cloudinary_secret"

# CLOUDINARY_API_KEY: Cloudinary key
CLOUDINARY_API_KEY="your_cloudinary_key"

# REDIS_URL: Redis URL connection string for BullMQ task queue
REDIS_URL="redis://localhost:6379"

# CRON_SECRET: Secret for protecting scheduled cron endpoint calls
CRON_SECRET="your_cron_secret"

